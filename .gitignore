# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# testing
/coverage
e2e/.auth/
e2e/test-results/
e2e/playwright-report/
/test-results/
/playwright-report/
.playwright-mcp/

# Python bytecode. The repo has no Python toolchain, but scripts/zh-check and
# scripts/story-lint are stdlib scripts and the latter imports its own module
# during --selftest, which materialises a cache directory next to the source.
__pycache__/
*.pyc

# Claude Code local state. `.claude/*` rather than `.claude/`: git refuses to
# re-include anything whose parent directory is excluded, so the directory
# itself must stay walkable for the project-local skills below to be tracked.
.claude/*
!.claude/skills/

# Health agent run output (HEALTH_ARTIFACT_DIR). Written by every local or CI
# health-agent command; the durable copy is the uploaded workflow artifact.
.health-agent-artifacts/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db
*.csv
!content/stockists/*.csv
*.png
# Playwright owns this one durable baseline set; all other generated PNGs stay ignored.
!e2e/tests/visual-regression.spec.ts-snapshots/*.png
# Images the app or the public front door needs. `*.png` above is deny-by-default
# and these were tracked in spite of it, not because of it — see the invariant
# note in the markdown block below. src/app/{icon,apple-icon}.png are what
# Next.js builds the favicon and apple-touch-icon from; a build cannot recover
# from losing them.
!public/images/*.png
!public/images/**/*.png
!src/app/icon.png
!src/app/apple-icon.png
!src/assets/brand/*.png
scripts/.backfill-backup-*.json
scripts/.quality-purge-backup-*.json
scripts/backup/
scripts/resort-heroes/preview.json
scripts/resort-heroes/completed.jsonl
# Restore manifests now live next to the review artifact (outside the repo, see
# scripts/shared/artifact.ts) so a `git clean -xdf` cannot destroy the only
# rollback record. This entry only covers manifests left by earlier local runs.
scripts/resort-heroes/manifests/

# local scratch / generated image output
/images/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files
.env
.env.local
.env.production.local
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
*.swp

# Strategy/internal docs (keep local, never push)
#
# INVARIANT: this is deny-by-default with named exceptions. Anything CI or the
# build reads MUST be listed below, or it will be silently unaddable the moment
# it is ever removed and re-added. That failure is invisible locally — the file
# stays on disk, so only a fresh clone or a CI runner sees it missing.
#
# These rules do not retroactively hide anything: gitignore has no effect on
# files that are already tracked. DEV-1389 untracked the ~89 that had been
# force-added past this block; until then it had been silently inert.
#
# MECHANIC: `docs/` below excludes the DIRECTORY, so no `!docs/...` negation can
# ever re-include a file inside it. Keeping an individual doc tracked requires
# relocating it out of docs/, not allow-listing it.
*.md
!README.md
!CONTRIBUTING.md
!marketing/cards/**/*.md
!marketing/items/**/*.md
!marketing/strategy/**/*.md
!.github/selfheal/*.md
# health-agent.yml reads these three at runtime (repair/review/sentry-classifier).
!.github/health-agent/*.md
!.github/PULL_REQUEST_TEMPLATE.md
# SEO measurement artifacts are shipped content, not internal strategy docs.
!content/seo/**/*.md
# Project-local Claude skills. These are executable specification, not docs:
# /write-stories reads its own voice pack at runtime, so an untracked voice file
# silently changes what the skill produces on a machine that lacks it.
!.claude/skills/**/*.md
# Linter dictionaries and golden fixtures. check.py parses forbidden-terms.md as
# its rule table and reads golden/*.md as its test suite, so both are code.
!scripts/story-lint/**/*.md
!scripts/zh-check/*.md
# The e2e failure-triage procedure. Named here per the INVARIANT above: the
# check:e2e-timeouts gate points contributors at it from its failure output, so
# CI depends on it existing. It lives in e2e/ rather than docs/ because the
# MECHANIC note above means nothing inside docs/ can ever be re-included.
!e2e/TRIAGE.md
docs/
# Ad-hoc production data-health queries. Not markdown, so the rule above misses
# them; referenced by nothing in the repo — they are hand-run pastes.
scripts/health-audit-*.sql
*.pen

# Supabase local artifacts only (keep migrations/config/functions/seed tracked)
supabase/.temp/
supabase/.branches/

# worktrees
.worktrees/

# Sentry Config File
.env.sentry-build-plugin

# Scraper
scripts/threads-scraper/

# seed data (local-only)
scripts/seeds/

# local data files
data/
!public/data/
!public/data/taiwan-counties.json

public/admin/content/

# search-eval run artifacts and stored baseline (DEV-1413 relevance gate). Same rule
# again: queries.json is the reviewed fixture and is committed, run output is not.
scripts/search-eval/runs/

# llm-eval run artifacts (DEV-1612 unified eval harness). Same rule: the harness
# is committed, its scored output and LLM audit sink are not.
scripts/llm-eval/runs/

# brand-storage-maintenance local manifests (operational artifacts, never committed)
scripts/.storage-purge-manifest-*.json
scripts/.reencode-originals-*.json
scripts/.remove-backup-*.json

# Production probe state cache (written by scripts/production-probe/probe.ts)
.probe-state/

# Production restore data from category cleanups (large, and it is a copy of rows
# that were deleted from production — belongs on disk, never in the repo history).
backups/
