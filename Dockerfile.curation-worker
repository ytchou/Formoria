FROM node:22-slim AS base
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
RUN node -e "const p=require('./package.json'); p.type='module'; require('fs').writeFileSync('package.json', JSON.stringify(p,null,2))"
COPY src/ src/
RUN pnpm install --frozen-lockfile
# Set AFTER the install: `NODE_ENV=production` makes pnpm skip devDependencies,
# so declaring it earlier would strip the build. At runtime it marks this
# container as production so anything gating on NODE_ENV (Sentry's server
# config, library production paths) behaves as deployed rather than as dev.
ENV NODE_ENV=production
# Identifies the build in the worker's startup log. Railway injects
# RAILWAY_GIT_COMMIT_SHA only for repo-connected services, so a manual
# `railway up` would otherwise log an unidentifiable build.
#
# The Railway CLI dropped `--build-arg` (verified absent in 5.30.4), so the SHA
# is set as a service variable instead and this ARG is only the fallback for
# builders that can still pass one:
#   railway variables --service curation-worker --set "WORKER_BUILD_SHA=$(git rev-parse HEAD)"
#   railway up --service curation-worker --ci
# Then confirm the deploy actually rolled:
#   railway logs --service curation-worker | grep "build sha"
ARG GIT_COMMIT_SHA=unknown
ENV WORKER_BUILD_SHA=$GIT_COMMIT_SHA
EXPOSE 8080
CMD ["pnpm", "curation:worker"]
