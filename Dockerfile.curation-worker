FROM node:22-slim AS base
RUN corepack enable
# git is required by the repo-worker and its agent for repository context.
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates postgresql-client && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
RUN node -e "const p=require('./package.json'); p.type='module'; require('fs').writeFileSync('package.json', JSON.stringify(p,null,2))"
COPY src/ src/
COPY scripts/ scripts/
COPY content/stories/ content/stories/
COPY content/trails/ content/trails/
RUN pnpm install --frozen-lockfile
RUN pnpm exec playwright install --with-deps chromium
# Codex CLI is the active repo-worker executor. Pin the exact version so Railway
# deployments remain reproducible.
RUN npm install -g @openai/codex@0.155.1
# Set AFTER the install: `NODE_ENV=production` makes pnpm skip devDependencies,
# so declaring it earlier would strip the build. At runtime it marks this
# container as production so anything gating on NODE_ENV (Sentry's server
# config, library production paths) behaves as deployed rather than as dev.
ENV NODE_ENV=production
ENV PATH="/app/node_modules/.bin:$PATH"
# pnpm runs scripts as `sh -c "<script>"`, and /bin/sh here is dash, which does
# not exec its final command. On container stop dash takes the SIGTERM and dies,
# pnpm exits 1 (ELIFECYCLE), and the worker's shutdown handler never runs, so
# Railway reports a crash. bash execs a single command, so the signal reaches
# the worker. Scoped to this image: pnpm-workspace.yaml would also change the
# web service and CI. Pinned by scripts/run-worker.test.ts.
ENV npm_config_script_shell=/bin/bash
# Identifies the build in the worker's startup log. Railway injects
# RAILWAY_GIT_COMMIT_SHA only for repo-connected services, so a manual
# `railway up` would otherwise log an unidentifiable build.
#
# The Railway CLI dropped `--build-arg` (verified absent in 5.30.4), so the SHA
# is set as a service variable instead and this ARG is only the fallback for
# builders that can still pass one:
#   railway variables --service curation-worker --set "WORKER_BUILD_SHA=$(git rev-parse HEAD)"
#   railway up --service curation-worker --ci
# Then confirm the deploy actually rolled:
#   railway logs --service curation-worker | grep "build sha"
# (The curation worker is a cron one-shot, so the line appears once per
# execution, not once per deploy.)
ARG GIT_COMMIT_SHA=unknown
ENV WORKER_BUILD_SHA=$GIT_COMMIT_SHA
# Four services build from this image. curation-worker (this CMD) and
# health-agent (its own start command) are cron one-shots that listen on no
# port; repo-worker and editorial-producer serve HTTP, so EXPOSE stays.
EXPOSE 8080
CMD ["pnpm", "curation:worker"]
