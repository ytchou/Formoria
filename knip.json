{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,template,error,not-found,loading,opengraph-image,twitter-image,icon,apple-icon,global-error,robots,sitemap}.{ts,tsx}",
    "src/curation-worker/server.ts",
    "src/health-agent/server.ts",
    "src/repo-worker/server.ts",
    "scripts/**/*.{ts,mjs}",
    "emails/**/*.{ts,tsx}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{ts,mjs}",
    "emails/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [],
  "ignoreBinaries": ["gh", "lsof", "psql", "python3", "scripts/run-worker.sh", "uv"],
  "ignore": [
    "scripts/threads-scraper/.venv/**"
  ],
  "ignoreIssues": {
    "src/components/ui/card.tsx": ["exports"],
    "src/app/admin/actions.ts": ["exports"],
    "src/test/server-only.ts": ["files"]
  }
}
