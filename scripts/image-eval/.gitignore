runs/
assets/
calls/
*.tmp

# Corpus holds both throwaway capture output and the definitional files the
# eval depends on. Ignore the directory, but track the three that are ground
# truth — manifest/roster define the corpus, labels.json is 231 hand-labeled
# verdicts that cannot be regenerated.
# Note: `corpus/*` not `corpus/` — git cannot re-include a file whose parent
# directory is excluded, so the negations below would not fire.
corpus/*
!corpus/manifest.json
!corpus/roster.json
!corpus/labels.json
