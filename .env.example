# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deployment environment and origins. Keep NEXT_PUBLIC_SITE_URL canonical in staging.
FORMORIA_DEPLOYMENT_ENV=development
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=

# Per-minute application rate limits. Production uses the defaults below;
# staging overrides them to 240 and 120 for the deployed E2E suite.
RATE_LIMIT_API_PER_MIN=60
RATE_LIMIT_BRANDS_INDEX_PER_MIN=30
NEXT_PUBLIC_DEPLOYMENT_ENV=development
NEXT_PUBLIC_SITE_URL=https://formoria.com
FORMORIA_RUNTIME_URL=http://localhost:3000
STAGING_BASE_URL=https://staging.formoria.com
PRODUCTION_BASE_URL=https://formoria.com

# Admin
ADMIN_EMAILS=your-email@example.com

# Personal OS internal executive API
PERSONAL_OS_INTERNAL_TOKEN=

# Railway service logs URL for admin job monitoring
RAILWAY_LOGS_URL=
# Injected by Railway; used for run-log provenance; optional locally.
RAILWAY_GIT_COMMIT_SHA=
# Crawler verification. Unset (or any value other than off/0/false) keeps SHADOW
# mode: crawler rate-limit exemption is granted on the User-Agent alone, so
# `curl -A Googlebot` bypasses the limits. Setting this to `off` switches to the
# Cloudflare-asserted `x-formoria-verified-bot` header instead.
# Two safety properties gate that switch, both live since 2026-08-07:
#   1. transform rule B overwrites the header on every non-bot request, so a
#      client-supplied value can never survive the edge;
#   2. a one-way interlock keeps enforcement off until the origin has actually
#      observed the header once, so flipping this before the rules exist is inert.
# Read docs/runbooks/cloudflare-edge.md before changing it.
VERIFIED_CRAWLER_SHADOW=

# Analytics (optional for dev)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://e.formoria.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_API_HOST=https://us.posthog.com
POSTHOG_DASHBOARD_URL=

# Sentry (optional for dev)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Resend (optional for transactional owner emails; staging Auth E2E never sends externally)
RESEND_API_KEY= # Resend API key for transactional owner emails; leave unset to no-op email sending
RESEND_MONITOR_API_KEY= # Optional dedicated key with Domains read access for health monitoring; do not reuse a send-only key

# Google Maps (optional — only for retail location widget)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cloudflare Turnstile (bot detection on submission form + challenge page)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Anti-scraping: Upstash Redis (optional — falls back to in-memory rate limiter)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Upstash Management API (optional — enables runtime limits and usage alerts)
UPSTASH_API_EMAIL=
UPSTASH_API_KEY=
UPSTASH_REDIS_DATABASE_ID=

# Cloudflare origin protection (optional — set when Cloudflare proxy is active)
CF_ORIGIN_SECRET=

# Cloudflare zone analytics (optional — enables the daily image-egress anomaly
# check at /api/cron/egress-anomaly-check; DEV-1744). The token needs only the
# zone-scoped "Analytics: Read" permission. Unset means the job reports
# "unconfigured" rather than failing.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Anti-scraping: Challenge cookie signing secret (required in production)
CHALLENGE_SECRET=

# E2E test accounts (required for pnpm test:e2e)
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=your-admin-password
E2E_USER_EMAIL=testuser@example.com
E2E_USER_PASSWORD=your-user-password
E2E_ORIGIN_SECRET=
# Shared only by the deployed staging app and authorized deep-suite runners.
# Use at least 32 random bytes; keep separate from origin and Access secrets.
E2E_STAGING_SESSION_SECRET=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Langfuse (LLM observability — optional for dev)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Comma-separated prompt version overrides (e.g. "founding-facts:3,founding-facts-verify:2"); leave blank to use Langfuse production labels
LANGFUSE_PROMPT_VERSIONS=

# Enrichment (required for brand enrichment pipeline)
SERPER_API_KEY=
OPENAI_API_KEY=

# Products agent (on by default; set to "off" to disable the products agent in the products phase)
PRODUCTS_AGENT=

# Editorial agent (on by default; set to "off" to disable the editorial agent
# that wraps descriptions/stockists/faq into a unified generate→validate→repair flow)
EDITORIAL_AGENT=

# IndexNow (required for Bing URL submission on deploy)
INDEXNOW_KEY=

# Slack alerting. TWO webhooks, split by audience.
#
#   SLACK_FORMORIA_WEBHOOK_URL  Formoria product alerts. Read by the app and
#     worker at runtime (src/lib/adapters/alerting/slack.ts -> job-alerts:
#     provider failures, circuit-breaker trips, job and worker failures) AND by
#     runtime monitoring jobs. Must be set on the Railway `Formoria` service or
#     every in-app alert no-ops after one console warning (DEV-1554).
#
#   SLACK_HEALTH_WEBHOOK_URL    Ops and monitoring workflows such as
#     production-probe.yml and spend-watch.yml. No app or worker code path reads it.
#
# Both post to #formoria-agent-alerts (C0BJ6TWPDF1). Confirmed 2026-08-24.
SLACK_FORMORIA_WEBHOOK_URL=

# Health Agent credentials (empty locally by default)
FORMORIA_RAILWAY_URL=
ORIGIN_SECRET=
AGENT_HUB_TURSO_DATABASE_URL=
AGENT_HUB_TURSO_AUTH_TOKEN=
SLACK_HEALTH_WEBHOOK_URL=

# Sentry health signals. Reuse SENTRY_AUTH_TOKEN above when it has event read
# scope, or set a dedicated SENTRY_READ_TOKEN. The health agent accepts either.
SENTRY_BASE_URL=
SENTRY_ORGANIZATION=
SENTRY_PROJECT=
SENTRY_READ_TOKEN=

# Linear health escalation
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_ACCESS_TOKEN=
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=
LINEAR_ASSIGNEE_ID=

# Health database roles and scoped internal API credentials
HEALTH_AGENT_READ_DATABASE_URL=
HEALTH_AGENT_READ_DATABASE_PASSWORD=
HEALTH_AGENT_WRITE_DATABASE_URL=
HEALTH_AGENT_WRITE_DATABASE_PASSWORD=
HEALTH_AGENT_READER_TOKEN=
HEALTH_AGENT_WRITER_TOKEN=

# Repository-scoped GitHub App and agent executors
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
CODEX_API_KEY= # Dedicated per-environment Codex key; do not reuse the application key or another environment's key

# Ops agent (DEV-1685) — Slack-driven operational assistant
# Bot OAuth token from the Slack app (xoxb-...). Requires chat:write scope.
SLACK_BOT_TOKEN=
# Signing secret from the Slack app — used to verify inbound request signatures.
SLACK_SIGNING_SECRET=
# Master kill switch. Set to "on" to enable the ops agent; any other value disables it.
OPS_AGENT=off
# Comma-separated operator allow-list: Slack user ID and Supabase auth email pairs.
# Format: U0AB12CD:patrick@formoria.com,U1EF34GH:ops@formoria.com
# The email must correspond to a Supabase auth user.
OPS_AGENT_OPERATORS=
# Maximum write-class actions per calendar day (UTC). Prevents runaway proposal execution.
OPS_AGENT_DAILY_CAP=50
# GitHub PAT scoped to actions:read + actions:write for workflow dispatch and run queries.
OPS_AGENT_GITHUB_TOKEN=

# DEV-1748: Repository worker (health agent quality detectors)
REPO_WORKER_URL=
REPO_WORKER_TOKEN=

# Claude Code Routines — ops agent delegates heavy work to subscription-powered sessions
# OPS_ROUTINE_TOKEN is the per-routine bearer token from the API trigger UI (sk-ant-oat01-...)
OPS_ROUTINE_TOKEN=
OPS_ROUTINE_ID=

