    "curation:render": "tsx --env-file=.env.local scripts/curation-rerun/render.ts",
    "backfill-images": "tsx --env-file=.env.local scripts/backfill-brand-images.ts",
    "backfill:tw": "tsx --env-file=.env.staging scripts/backfill-tw-localization.ts",
    "brand-storage-maintenance": "tsx --env-file=.env.local scripts/brand-storage-maintenance.ts",
    "link-cleanup": "tsx --env-file=.env.local scripts/link-cleanup/run.ts",
    "approve-ready": "tsx --env-file=.env.local scripts/approve-ready-submissions.ts",
    "seed-events": "tsx --env-file=.env.local scripts/seed-events.ts",
    "story:facts": "tsx --env-file=.env.local scripts/story-facts.ts",
    "audit:event-exhibitors": "tsx scripts/audit-event-exhibitors.ts",
    "rerun-curation": "tsx --env-file=.env.local scripts/rerun-submission-curation.ts",
    "seed-expo-content": "tsx --env-file=.env.local scripts/seed-expo-exhibitor-content.ts",
    "reject-skipped": "tsx --env-file=.env.local scripts/reject-skipped-submissions.ts",
    "derive-category": "tsx --env-file=.env.local scripts/derive-missing-category.ts",
    "clear-contaminated-links": "tsx --env-file=.env.local scripts/clear-contaminated-links.ts",
    "remove-brand": "tsx --env-file=.env.local scripts/remove-brand.ts",
    "repair-brand-images": "tsx --env-file=.env.local scripts/repair-brand-images.ts",
    "resort-heroes:preview": "tsx --env-file=.env.local scripts/resort-heroes/preview.ts",
    "resort-heroes:render": "tsx --env-file=.env.local scripts/resort-heroes/render.ts",
    "resort-heroes:apply": "tsx --env-file=.env.local scripts/resort-heroes/apply.ts",
    "resort-heroes:rollback": "tsx --env-file=.env.local scripts/resort-heroes/rollback.ts",
    "image-recovery:audit": "tsx --env-file=.env.local scripts/image-recovery-audit.ts",
    "seo:counts": "tsx --env-file=.env.local scripts/seo/brand-counts.ts",
    "seo:gsc-export": "tsx --env-file=.env.local scripts/seo/search-console-export.ts",
    "seo:gsc-404": "tsx --env-file=.env.local scripts/seo/gsc-404-triage.ts",
    "seo:redirect-health": "tsx --env-file=.env.local scripts/seo/redirect-health.ts",
    "test:e2e": "playwright test --project=deep",
    "test:e2e:smoke": "playwright test --project=deep --grep @smoke",
    "test:e2e:cross-browser": "playwright test --project=cross-browser-chromium --project=cross-browser-firefox --project=cross-browser-webkit --grep @cross-browser e2e/tests/landing-search-cross-browser.spec.ts",
    "test:e2e:deep": "playwright test --project=deep",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:search:load": "node --env-file=.env.local scripts/search-load.mjs",
    "design:tokens": "node scripts/generate-design-tokens.mjs",
    "check:design-tokens": "node scripts/generate-design-tokens.mjs --check",
    "check:category-redirects": "tsx scripts/generate-category-redirects.ts --check",
    "langfuse:seed": "tsx scripts/langfuse-seed.ts",
    "brand-names:backfill": "tsx --env-file=.env.local scripts/name-backfill/run.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.2.2",
    "@libsql/client": "^0.17.4",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.112.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "adm-zip": "^0.6.0",
    "agentation": "^3.0.2",
    "cheerio": "^1.2.0",
