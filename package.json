    "embla-carousel-react": "^8.6.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.4",
    "langfuse": "^3.38.20",
    "lucide-react": "^1.30.0",
    "next": "16.2.10",
    "next-intl": "^4.13.7",
    "next-mdx-remote": "^6.0.0",
    "pinyin-pro": "^3.29.3",
    "posthog-js": "^1.409.5",
    "posthog-node": "^5.46.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.83.0",
    "react-simple-maps": "^3.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-playwright": "^2.11.0",
    "jsdom": "^29.1.1",
    "knip": "^6.23.0",
    "lighthouse": "13.4.1",
    "prettier": "^3.9.6",
    "react-email": "^6.6.8",
    "shadcn": "^4.18.0",
    "supabase": "2.110.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vite": ">=8.2.2",
    "vitest": "^4.1.9"
  }
}
