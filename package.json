    "check:favicon": "node scripts/check-favicon-rgba.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:frontend-tokens": "node scripts/check-frontend-type-tokens.mjs",
    "check:test-boundaries": "node scripts/check-test-boundaries.mjs",
    "story:lint": "python3 scripts/story-lint/check.py",
    "check:audited-calls": "node scripts/check-audited-external-calls.mjs",
    "check:storage-transforms": "node scripts/check-storage-transforms.mjs",
    "check:error-boundaries": "node scripts/check-error-boundaries.mjs",
    "check:service-registry": "node scripts/check-service-registry.mjs",
    "check:test-brand-filter": "node scripts/check-test-brand-filter.mjs",
    "check:zh-terms": "tsx scripts/check-zh-terms.ts",
    "check:e2e-timeouts": "node scripts/check-e2e-timeouts.mjs",
    "check:image-resolvability": "tsx scripts/check-image-resolvability.ts",
    "check:photo-bands": "tsx scripts/check-photo-band-contrast.ts",
    "check:e2e-report": "tsx scripts/e2e-report-gate.ts",
