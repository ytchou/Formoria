{
  "name": "formoria",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "next dev",
    "email:dev": "email dev",
    "build": "next build && node scripts/check-brand-prerender-budget.mjs",
