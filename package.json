{
  "name": "formoria",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "next dev",
    "email:dev": "email dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint && pnpm check:frontend-tokens && pnpm check:test-boundaries && pnpm check:audited-calls && pnpm check:storage-transforms && pnpm check:test-brand-filter && pnpm check:e2e-timeouts && pnpm check:service-registry",
    "check:favicon": "node scripts/check-favicon-rgba.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:frontend-tokens": "node scripts/check-frontend-type-tokens.mjs",
    "check:test-boundaries": "node scripts/check-test-boundaries.mjs",
    "check:audited-calls": "node scripts/check-audited-external-calls.mjs",
    "check:storage-transforms": "node scripts/check-storage-transforms.mjs",
    "check:service-registry": "node scripts/check-service-registry.mjs",
    "check:test-brand-filter": "node scripts/check-test-brand-filter.mjs",
    "check:e2e-timeouts": "node scripts/check-e2e-timeouts.mjs",
    "snapshot:e2e-timeouts": "node scripts/check-e2e-timeouts.mjs --snapshot",
    "db:types": "npx supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "check:db-types": "node scripts/check-db-types-fresh.mjs",
    "knip": "knip",
    "prepare": "git config core.hooksPath scripts/hooks 2>/dev/null || true",
    "curate": "tsx --env-file=.env.local scripts/curate-brands.ts",
    "posthog:sync": "tsx --env-file=.env.local scripts/posthog-sync.ts",
    "curation:worker": "tsx scripts/curation-worker-server.ts",
    "curation:snapshot": "tsx --env-file=.env.local scripts/curation-rerun/snapshot.ts",
    "curation:rerun": "tsx --env-file=.env.local scripts/curation-rerun/refresh.ts",
    "curation:render": "tsx --env-file=.env.local scripts/curation-rerun/render.ts",
    "backfill-images": "tsx --env-file=.env.local scripts/backfill-brand-images.ts",
    "brand-storage-maintenance": "tsx --env-file=.env.local scripts/brand-storage-maintenance.ts",
    "approve-ready": "tsx --env-file=.env.local scripts/approve-ready-submissions.ts",
    "seed-events": "tsx --env-file=.env.local scripts/seed-events.ts",
    "audit:event-exhibitors": "tsx scripts/audit-event-exhibitors.ts",
    "rerun-curation": "tsx --env-file=.env.local scripts/rerun-submission-curation.ts",
    "seed-expo-content": "tsx --env-file=.env.local scripts/seed-expo-exhibitor-content.ts",
    "reject-skipped": "tsx --env-file=.env.local scripts/reject-skipped-submissions.ts",
    "default-price-range": "tsx --env-file=.env.local scripts/default-missing-price-range.ts",
    "derive-product-type": "tsx --env-file=.env.local scripts/derive-missing-product-type.ts",
    "clear-contaminated-links": "tsx --env-file=.env.local scripts/clear-contaminated-links.ts",
    "remove-brand": "tsx --env-file=.env.local scripts/remove-brand.ts",
    "repair-brand-images": "tsx --env-file=.env.local scripts/repair-brand-images.ts",
    "resort-heroes:preview": "tsx --env-file=.env.local scripts/resort-heroes/preview.ts",
    "resort-heroes:render": "tsx --env-file=.env.local scripts/resort-heroes/render.ts",
    "resort-heroes:apply": "tsx --env-file=.env.local scripts/resort-heroes/apply.ts",
    "resort-heroes:rollback": "tsx --env-file=.env.local scripts/resort-heroes/rollback.ts",
    "backfill-image-focal-points": "tsx --env-file=.env.local scripts/backfill-image-focal-points.ts",
    "image-eval:capture": "tsx --env-file=.env.local scripts/image-eval/capture.ts",
    "image-eval:review": "tsx --env-file=.env.local scripts/image-eval/review.ts",
    "image-eval:baseline": "tsx --env-file=.env.local scripts/image-eval/baseline.ts",
    "image-eval:score": "tsx --env-file=.env.local scripts/image-eval/score.ts",
    "image-recovery:audit": "tsx --env-file=.env.local scripts/image-recovery-audit.ts",
    "normalize-tags-en": "tsx --env-file=.env.local scripts/normalize-product-tags-en.ts",
    "seo:counts": "tsx --env-file=.env.local scripts/seo/brand-counts.ts",
    "seo:gsc-export": "tsx --env-file=.env.local scripts/seo/search-console-export.ts",
    "seo:gsc-404": "tsx --env-file=.env.local scripts/seo/gsc-404-triage.ts",
    "seo:redirect-health": "tsx --env-file=.env.local scripts/seo/redirect-health.ts",
    "test:e2e": "playwright test --project=deep --project=mobile",
    "test:e2e:smoke": "playwright test --project=deep --grep @smoke",
    "test:e2e:cross-browser": "playwright test --project=cross-browser-chromium --project=cross-browser-firefox --project=cross-browser-webkit --grep @cross-browser e2e/tests/landing-search-cross-browser.spec.ts",
    "test:e2e:deep": "playwright test --project=deep",
    "test:search:load": "node --env-file=.env.local scripts/search-load.mjs",
    "search:eval": "tsx --env-file=.env.local scripts/search-eval/run.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.4",
    "@hookform/resolvers": "^5.2.2",
    "@internationalized/date": "^3.12.3",
    "@radix-ui/react-accordion": "^1.2.13",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@sentry/nextjs": "^10.51.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.9",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "adm-zip": "^0.6.0",
    "agentation": "^3.0.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.4",
    "lucide-react": "^1.30.0",
    "next": "16.2.10",
    "next-intl": "^4.13.0",
    "next-mdx-remote": "^6.0.0",
    "pinyin-pro": "^3.28.1",
    "posthog-js": "^1.409.5",
    "posthog-node": "^5.46.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.83.0",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.10.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-playwright": "^2.11.0",
    "jsdom": "^29.1.1",
    "knip": "^6.23.0",
    "prettier": "^3.9.6",
    "react-email": "^6.6.8",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vite": ">=8.1.4",
    "vitest": "^4.1.9"
  }
}
