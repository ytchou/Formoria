{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@emails/*": ["./emails/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // `workers` joins `supabase/functions` for the same reason: both are
  // non-Next.js runtimes with their own globals, bundled by their own
  // toolchain (wrangler / the Supabase CLI), so checking them against the
  // app's `lib` and paths reports errors that mean nothing.
  "exclude": [
    "node_modules",
    "supabase/functions",
    "workers",
    "e2e",
    "scripts/*.test.ts",
    "playwright.config.ts"
  ]
}
