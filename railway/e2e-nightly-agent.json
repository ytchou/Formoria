{
  "$comment": "Documentation-only — Railway does not read per-service JSON files. This records the intended service configuration for the e2e-nightly-agent Railway service.",
  "service": "e2e-nightly-agent",
  "schedule": "05 20 * * * (UTC)",
  "startCommand": "pnpm e2e:nightly",
  "envVars": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "FORMORIA_DEPLOYMENT_ENV",
    "SLACK_FORMORIA_WEBHOOK_URL",
    "LANGFUSE_SECRET_KEY",
    "LANGFUSE_PUBLIC_KEY",
    "LANGFUSE_BASEURL",
    "GITHUB_APP_ID",
    "GITHUB_PRIVATE_KEY",
    "GITHUB_INSTALLATION_ID",
    "CF_ACCESS_CLIENT_ID",
    "CF_ACCESS_CLIENT_SECRET",
    "E2E_ADMIN_EMAIL",
    "E2E_ADMIN_PASSWORD",
    "E2E_USER_EMAIL",
    "E2E_USER_PASSWORD",
    "LINEAR_API_KEY",
    "LINEAR_LABEL_E2E_NIGHTLY"
  ]
}
